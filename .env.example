# AI-CHHE 2026 — environment template.
# PLACEHOLDERS ONLY. Never commit real credentials (spec §16).
# Copy to `.env.local` for local development. Lines for features you are not
# using yet can be removed — they are optional at this phase.

# --- Runtime -----------------------------------------------------------
NODE_ENV=development
# Canonical public origin, no trailing slash. Used to build attendee links
# and URLs inside emails.
APP_BASE_URL=http://localhost:3000
PORT=3000

# --- Database (MySQL) — server-only secret ------------------------------
DATABASE_URL=mysql://user:password@127.0.0.1:3306/ai_chee_2026
# Optional connection pool size for the app (default 10).
DB_CONNECTION_LIMIT=10

# --- Admin auth (initial phase: one env-configured admin, no admin table)
ADMIN_EMAIL=admin@example.com
# Preferred: a precomputed hash (argon2id/bcrypt). NEVER a plaintext password.
ADMIN_PASSWORD_HASH=$2b$12$replacewithalongexamplehashhashhashhashhashhashhashhash
# Session signing secret, minimum 32 chars. Generate: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-long-random-secret-at-least-32-chars

# --- S3-compatible object storage (private bucket) ----------------------
AWS_REGION=ap-south-1
AWS_S3_BUCKET=replace-with-private-bucket-name
# Prefer deployment IAM roles. Leave unset when the platform provides
# credentials; otherwise fill from your secret manager, never commit real keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Redis / background jobs (BullMQ) -----------------------------------
# Required by the email worker. Local dev:
#   docker run -d --name aichee-redis -p 127.0.0.1:6379:6379 redis:7
REDIS_URL=redis://127.0.0.1:6379/0
# Email worker concurrency (default 5).
EMAIL_WORKER_CONCURRENCY=5

# --- Transactional email (SMTP) -----------------------------------------
# Any SMTP provider works — no vendor SDK. Production example:
#   smtp://username:password@smtp.provider.example:587
# Local dev with Mailpit (captures all mail): smtp://127.0.0.1:1025
EMAIL_SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=AI-CHHE 2026
